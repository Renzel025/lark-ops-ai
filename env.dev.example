# =============================================================================
# Dev overlay — loaded ON TOP of repo .env when ENV_PROFILE=dev
# Copy once:  cp env.dev.example .env.dev
# Keep LARK_APP_ID / secrets in .env only; change only dev routing & toggles here.
# =============================================================================

# --- Single P0 group (no detection / prompt split) ---
# Match prod keyword gates (prod leaves both unset → AI triage on, GROQ_GATE off):
# P0_KEYWORD_GROQ_GATE=0
P0_SINGLE_INCIDENT_GROUP=1
INCIDENT_GROUP_IDS=oc_your_one_p0_group_id
INCIDENT_GROUP_EMERGENCY_TOPICS="oc_your_one_p0_group_id=p0 detection dev"
# Remove or comment out when using single group:
# INCIDENT_OVERVIEW_TARGET_MAP=oc_detection_dev=oc_prompt_dev
# OVERVIEW_TARGET_GROUP_CHAT_ID=oc_prompt_dev
# P0_OVERVIEW_POST_CHAT_ID=oc_prompt_dev

# Duty DM for local testing (set your ou_...)
P0_DM_INSTRUCTION_OPEN_IDS=ou_your_open_id

# Issue Watch — same duty route; uses the one group above
P0_ISSUE_WATCH_ENABLED=1
P0_ISSUE_WATCH_AUTO_OVERVIEW=1
P0_ISSUE_WATCH_AI_PROVIDER=claude
# Dev testing — alert on first high-confidence report (prod defaults: MIN_SOLO_REPORTERS=2, COOLDOWN_MIN=20)
P0_ISSUE_WATCH_MIN_SOLO_REPORTERS=1
P0_ISSUE_WATCH_MIN_AFFECTED_PLAYERS=3
P0_ISSUE_WATCH_COOLDOWN_MIN=1
P0_ISSUE_WATCH_MIN_CONFIDENCE=0.85
# Shorter P0 meeting cooldown after false-positive footer triggers (prod default 300s)
P0_COOLDOWN_SEC=60
# OAuth subscription (setup-token): use Haiku 4.5 API id — NOT claude-3-5-haiku-20241022
ANTHROPIC_OAUTH_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_AUTH_TOKEN=sk-ant-oat01-...
# P0_ANTHROPIC_PREFER_OAUTH=1

# VC auto-ring (dev only): when duty joins P0 VC, ring users @mentioned on concern / duty @mentions
# Also rings P0_MAJOR_CHECK_PERSON_IDS (not DM-only).
P0_VC_RING_ENABLED=1
# Public HTTPS base (nginx) + callback registered in Lark Developer Console → OAuth redirect URL
# Replace with your dev host (required before ring works)
P0_VC_OAUTH_PUBLIC_BASE_URL=https://your-dev-server.example.com
P0_VC_OAUTH_REDIRECT_URI=https://your-dev-server.example.com/lark/oauth/callback
# Scope: vc:meeting (ring) + vc:record (Minutes view) + docs:permission.* (Minutes **Can edit** upgrade)
# P0_VC_OAUTH_SCOPE=vc:meeting offline_access vc:record docs:permission.member:create docs:permission.member:update
# Optional test target when concern has no @mention:
# P0_VC_RING_FALLBACK_OPEN_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Fixed list auto-invited into EVERY new P0/P1 meeting the moment it's created (rung when the
# declarer joins the VC). Independent of major-check-person / duty rosters.
# P0_VC_AUTO_INVITE_OPEN_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx,ou_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# VC recording share + notify (after meeting ends → Minutes ready)
# Set boss ou_ = appears in Minutes collaborators (Can edit when DRIVE_PERM=edit + OAuth scopes ok)
# Recording: interactive card only (no 2nd RECORDING_READY text). Boss bot needs text? VC_RECORDING_FANOUT_PLAIN_META=1
# VC_RECORDING_FANOUT_PLAIN_META=0
# VC_RECORDING_FANOUT_USER_OPEN_IDS=ou_boss_open_id
# VC_RECORDING_FANOUT_CHAT_IDS=oc_boss_bot_group_id   # boss bot ONLY — not your P0 group
# VC_RECORDING_FANOUT_DRIVE_PERM=edit                 # Minutes collaborators: Can edit (Drive API)
# Hub is for P0 join text only — recording uses VC_RECORDING_FANOUT_* above, not the hub:
# P0_NOTIFICATION_HUB_CHAT_IDS=oc_your_boss_hub_group
# VC_RECORDING_FANOUT_TOPIC_SUBSTRING=Video meeting
# VC_RECORDING_FANOUT_SET_PERMISSION=1
# set_permission needs duty user OAuth (not tenant token). Re-auth after adding vc:record scope.
# Dev-only fallback if links stay "Access restricted":
# VC_RECORDING_FANOUT_TENANT_WIDE_VIEW=1

# --- Ops monitoring GC (duty warning mirrors + log ERROR alerts) ---
# P0_MONITORING_CHAT_IDS=oc_your_dev_monitoring_group
# P0_MONITORING_DUTY_WARNINGS=1
# P0_MONITORING_LOG_ALERTS=1

# Local shared state (drafts / issue-watch alert disk) — not prod path
# P0_SESSION_DISK_DIR=/tmp/lark-ops-ai-sessions
# P0_ISSUE_WATCH_ALERT_DISK_DIR=/tmp/lark-ops-ai-issue-watch

# --- Bitable deployment / ops cards (same Base as prod — required for 🔴 ops + 📦 deploy on P0 declare) ---
# Copy these into .env if shared, or uncomment here for .env.dev overlay only.
# Lark app scope: bitable:app:readonly (or bitable:app)
# P0_ADJUSTMENT_BITABLE_ENABLED=1
# P0_ADJUSTMENT_BITABLE_APP_TOKEN=LVrubE8f8af1yTslQgqlIaWPgcg
# P0_ADJUSTMENT_BITABLE_TABLE_ID=tblHHa3NmHmWian6
# P0_ADJUSTMENT_BITABLE_OPS_TABLE_ID=tblTNzlhFdyrKgG8
# P0_ADJUSTMENT_BITABLE_ON_P0_DECLARE=1
# Two separate prompts: deploy page 1 + ops page 1 in main group; extra pages in each thread:
# P0_ADJUSTMENT_BITABLE_THREAD_FOLLOWUPS=1
# P0_ADJUSTMENT_BITABLE_OPS_PAGE_SIZE=8
