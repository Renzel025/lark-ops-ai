# =============================================================================
# Dev overlay — loaded ON TOP of repo .env when ENV_PROFILE=dev
# Copy once:  cp env.dev.example .env.dev
# Keep LARK_APP_ID / secrets in .env only; change only dev routing & toggles here.
# =============================================================================

# --- Detection / prompt dev groups (✎ your p0 detection dev + prompt dev oc_...) ---
INCIDENT_GROUP_IDS=oc_your_detection_dev_group_id
INCIDENT_OVERVIEW_TARGET_MAP=oc_detection_dev=oc_prompt_dev
INCIDENT_GROUP_EMERGENCY_TOPICS="oc_detection_dev=p0 detection dev"

# Duty DM for local testing (✎ your ou_...)
P0_DM_INSTRUCTION_OPEN_IDS=ou_your_open_id

# Issue Watch — same duty route; uses dev detection group above
P0_ISSUE_WATCH_ENABLED=1
P0_ISSUE_WATCH_AUTO_OVERVIEW=1

# VC auto-ring (dev only): when duty joins P0 VC, ring users @mentioned on concern / duty @mentions
P0_VC_RING_ENABLED=1
# Public HTTPS base (nginx) + callback registered in Lark Developer Console → OAuth redirect URL
# ✎ replace with your dev host (required before ring works)
P0_VC_OAUTH_PUBLIC_BASE_URL=https://your-dev-server.example.com
P0_VC_OAUTH_REDIRECT_URI=https://your-dev-server.example.com/lark/oauth/callback
# Scope must include offline_access (for refresh_token) + vc:meeting; enable offline_access in Lark app permissions
# P0_VC_OAUTH_SCOPE=vc:meeting offline_access
# Optional test target when concern has no @mention:
# P0_VC_RING_FALLBACK_OPEN_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local shared state (drafts / issue-watch alert disk) — not prod path
P0_SHARED_STATE_DIR=/tmp/lark-ops-ai-dev-state

# Faster / quieter dev (re-enable on server prod .env)
P0_GRAPH_SCREENSHOT_ENABLED=0
SLACK_HUDDLE_ON_P0_START=0
SLACK_HUDDLE_ON_OVERVIEW_SEND=0
SLACK_NOTIFY_CHANNEL_ON_P0_DECLARE_WITH_SEVERITY=0

# Optional: point forwarder at local instance
# LARK_OVERVIEW_FORWARDER_URL=http://127.0.0.1:8010
