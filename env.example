# =============================================================================
# lark-ops-ai — buong .env template
# Kopyahin: cp env.example .env   tapos punan ang values.
# PROD: palitan ang mga may tsek (✎) — lalo na group ids at secrets.
# =============================================================================

# --- Lark app (✎ PROD: i-rotate ang secret kung na-leak sa chat/log) ----------
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=your_app_secret_here
LARK_ENCRYPT_KEY=your_encrypt_key_here

# Optional: ibang API host kung hindi SG node (tinignan ng ilang custom code)
LARK_BASE_URL=https://open-sg.larksuite.com

# --- Path ng .env sa server (✎ dapat tama ang absolute path) ----------------
ENV_PATH=/home/ubuntu/lark-ops-ai/.env

# --- Incident / P0-P1 routing (✎ PROD: bagong group = bagong oc_...) ---------
# One or more incident groups (comma-separated). P0/P1 works in ANY of these chats.
# Prefer INCIDENT_GROUP_IDS for multiple; or use INCIDENT_GROUP_ID=oc_a,oc_b
INCIDENT_GROUP_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# INCIDENT_GROUP_IDS=oc_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,oc_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# Optional: per-group line for meeting cards ``🚨 P0 — …`` + Lark VC topic (comma-separated oc_=text)
# INCIDENT_GROUP_EMERGENCY_TOPICS=oc_aaa=CP-Emergency feedback紧急问题反馈群,oc_bbb=Game urgent-游戏紧急群
# Kung walang match, ginagamit ang MEETING_TOPIC sa baba.

# Optional: lahat ng "Send overview" dito mag-post (fixed channel). Kung blanko: sa group kung saan nag-start ang session.
# OVERVIEW_TARGET_GROUP_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# (alias) P0_OVERVIEW_POST_CHAT_ID=

# Legacy / hindi na ginagamit ng core bot — puwedeng tanggalin
LARK_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
P0_TARGET_GROUP_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- VC meeting host (✎ unang ou_ = organizer / owner_id sa reserve) ---------
# Puwede P0_OWNER_OPEN_IDS o P0_INVITEE_OPEN_IDS (parehong binabasa ng code)
P0_OWNER_OPEN_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# o:
# P0_INVITEE_OPEN_IDS=ou_aaa,ou_bbb

# --- Ignore: hindi makakapag-trigger ng p0/p1 sa incident group (optional) ----
# Iwanang blanko kung wala pang i-ignore
P0_TRIGGER_IGNORE_OPEN_IDS=

# --- Sino makakatanggap ng DM “incident details” card (optional) --------------
# Kung blanko: yung nag-type ng p0/p1 ang makakatanggap.
# Maramihan: P0_DM_INSTRUCTION_OPEN_IDS=ou_a,ou_b,ou_c
# (Ang OVERVIEW_DM_OPEN_ID / P0_DM_USER_OPEN_ID sa lumang .env HINDI na binabasa ng p0_logic;
#  gamitin ang dalawa sa baba kung fixed recipient kayo.)
P0_DM_INSTRUCTION_OPEN_ID=
# P0_DM_INSTRUCTION_OPEN_IDS=

# --- Groq ---------------------------------------------------------------------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- HTTP ---------------------------------------------------------------------
REQ_TIMEOUT=10

# --- Support sheet (participants / support map) -------------------------------
SUPPORT_SHEET_SPREADSHEET_TOKEN=your_sheet_token
SUPPORT_SHEET_NAME=Sheet1
SUPPORT_SHEET_RANGE=A:B

# --- Wiki group AI ------------------------------------------------------------
WIKI_GROUP_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WIKI_DOC_TOKEN=your_wiki_doc_token
WIKI_HTTP_TIMEOUT=30

# --- Timing / behavior (p0_logic defaults kung wala) --------------------------
# P0_COOLDOWN_SEC=300
# AUTO_PREVIEW_DELAY_SEC=6
# ONGOING_CARD_DELAY_SEC=600
# P1_TO_P0_ESCALATION_SEC=900

# --- Legacy / hindi ginagamit ng kasalukuyang p0_logic/main.py ----------------
# (Pwede mong iwan kung may ibang branch/tool; safe na walang epekto sa core bot.)
P0_DM_INVITE=1
OVERVIEW_DM_OPEN_ID=
P0_DM_USER_OPEN_ID=
AUTO_POST_OVERVIEW_CARD=0
DM_OCR_ENABLED=1
HEADFUL_ONCE=0
FORCE_SHOW_TEST_CARDS=false

# --- Optional: topic ng VC (may default sa config) ------------------------------
# MEETING_TOPIC=CP-Emergency feedback紧急问题反馈群
