# =============================================================================
# lark-ops-ai — full .env template
# Copy: cp env.example .env   then fill in values.
# PROD: replace lines marked (✎) — especially group IDs and secrets.
# =============================================================================

# --- Lark app (✎ PROD: rotate secret if leaked in chat/logs) ----------------
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=your_app_secret_here
LARK_ENCRYPT_KEY=your_encrypt_key_here
# Lark app permissions: bot needs im:message + im:message:send_as_bot + im:message:update
# so the red “Join meeting” card can be PATCHed closed when the VC ends (removes join link in-place).
# For “Cancel preview”: bot recalls the preview card via DELETE message — add im:message:recall if required by your tenant.

# Open Platform API base (must end with …/open-apis). Default SG; p0_logic reads LARK_OPEN_API_BASE.
# LARK_BASE_URL below is legacy / unused by p0_logic — use LARK_OPEN_API_BASE to override.
LARK_BASE_URL=https://open-sg.larksuite.com
# LARK_OPEN_API_BASE=https://open-sg.larksuite.com/open-apis

# --- Path to .env on server (✎ use correct absolute path) -------------------
ENV_PATH=/home/ubuntu/lark-ops-ai/.env

# --- Dev environments (NOT production) -----------------------------------------
# **Separate staging server (recommended):** clone repo on another VM, then:
#   cp env.staging.example .env && bash scripts/setup_staging_server.sh
#   systemd: lark-ops-ai-staging.service — dev Lark groups + webhook URL only.
#
# **Local Mac overlay:** secrets in .env, routing in .env.dev:
#   cp env.dev.example .env.dev && bash scripts/run_dev.sh  (ENV_PROFILE=dev)
#
# Production (ose-bot): this file only — never ENV_PROFILE, never .env.dev.

# --- Incident / P0-P1 routing (✎ PROD: new group = new oc_...) ---------------
# One or more incident groups (comma-separated). P0/P1 works in ANY of these chats.
# Prefer INCIDENT_GROUP_IDS for multiple; or use INCIDENT_GROUP_ID=oc_a,oc_b
# Do not define INCIDENT_GROUP_IDS twice (or both IDs + IDs) — .env last line wins; garbage like "o" => ignored chats.
INCIDENT_GROUP_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# INCIDENT_GROUP_IDS=oc_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,oc_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
#
# --- Single group mode (no detection + prompt split) ---
# Set to 1 when everything happens in ONE Lark group. Removes need for INCIDENT_OVERVIEW_TARGET_MAP.
# P0_SINGLE_INCIDENT_GROUP=1
#
# Legacy split (detection quiet + prompt for cards) — leave SINGLE_INCIDENT_GROUP unset or 0:

# Optional: per-group line for meeting cards ``🚨 P0 — …`` + Lark VC topic (comma-separated oc_=text)
# Values with spaces MUST be in double quotes (bash/systemd `source` breaks otherwise):
# INCIDENT_GROUP_EMERGENCY_TOPICS="oc_aaa=CP-Emergency feedback紧急问题反馈群,oc_bbb=Game urgent-游戏紧急群"
# If no match, MEETING_TOPIC below is used.
#
# Manual paste of bilingual **P0 Incident Overview** (first line ``P0 Incident Overview`` / ``P0 事故概览``)
# does not trigger a new VC — keyword path ignores that template.
#
# DM command ``create overview emergency|game`` (no meeting): optional explicit routing:
# P0_STANDALONE_OVERVIEW_TAGS=emergency=oc_aaa,game=oc_bbb
# (If blank: auto-match labels — "emergency" in topic → emergency; "game" or 游戏 → game.)

# Optional: fixed "Send overview" Lark post when you do not use INCIDENT_OVERVIEW_SEND_MAP (legacy single channel).
# OVERVIEW_TARGET_GROUP_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# (alias) P0_OVERVIEW_POST_CHAT_ID=
#
# Legacy **mirror** routing: detection oc_ -> **prompt** group for meeting invite, P1 card, ended/cancel, cooldown text.
# Comma-separated oc_detection=oc_prompt. Example:
# INCIDENT_OVERVIEW_TARGET_MAP=oc_detection_dev=oc_prompt_test_dev,...
# (If a detection oc_ is missing from the map, falls back to OVERVIEW_TARGET_GROUP_CHAT_ID or same group.)
#
# --- Detection = quiet for meeting; prompt = all bot cards; overview text back to detection ---
# ``0`` (default): meeting UX goes to the **prompt** side of TARGET_MAP (above).
# ``1``: meeting UX stays in **detection** (old “cards in incident” mode).
# P0_MEETING_CARDS_IN_SOURCE_INCIDENT_CHAT=0
#
# Minimal **P0 meeting created + Join link** card to boss / hub (not the full red Meeting ID invite).
# One hub for **both** join text + recording-available text (simplest):
# P0_NOTIFICATION_HUB_CHAT_IDS=oc_30df0e66cb5411c0be1d96488d21a187
# Or set separately:
# P0_MEETING_CREATED_TEXT_CHAT_IDS=oc_aaa,oc_bbb
# VC_RECORDING_FANOUT_CHAT_IDS=oc_aaa
# Per detection join text only: P0_MEETING_CREATED_TEXT_MAP=oc_detection=oc_po_room
# Cancelled meeting fan-out (grey card) — defaults to same groups as P0_MEETING_CREATED_TEXT_CHAT_IDS / hub
# P0_MEETING_CANCELLED_FANOUT_ENABLED=1
# P0_MEETING_CANCELLED_FANOUT_CHAT_IDS=oc_boss_group_id
# (alias) P0_MEETING_ALERT_TEXT_CHAT_IDS=  P0_HUB_CHAT_IDS=
#
# --- Ops monitoring group (duty warning mirrors + log ERROR alerts) ---
# Bot (prod app) must be a member of each monitoring group.
# Put flags on their own line — no inline ``# comment`` after the value.
# P0_MONITORING_CHAT_IDS=oc_your_ops_monitoring_group
# P0_MONITORING_DUTY_WARNINGS=1
# P0_MONITORING_LOG_ALERTS=1
# P0_MONITORING_LOG_MIN_LEVEL=ERROR
# P0_MONITORING_ALERT_COOLDOWN_SEC=120
#
# ``1``: **Send overview** posts to **detection** (source incident ``oc_``), not the prompt ``target_chat``.
# Use with MEETING_CARDS=0 + TARGET_MAP so prompts stay in prompt group, overview in detection.
# P0_OVERVIEW_POST_TO_INCIDENT_SOURCE_CHAT=0
# After Send overview: **Edit overview** on the group card → edit in DM → Save updates that group message (primary bot posts only).
# P0_GROUP_OVERVIEW_EDIT_ENABLED=1
# Overview generation LLM (issue one-liner + zh_issue/zh_impact one-shot). Mirrors P0_ISSUE_WATCH_AI_PROVIDER.
#   auto (default): Claude if configured, else Groq; Claude fail/parse-error → Groq → legacy summarize_issue.
#   Force one: P0_OVERVIEW_AI_PROVIDER=claude|groq. Claude auth = ANTHROPIC_* + P0_ANTHROPIC_PREFER_OAUTH (OAuth preferred, API key fallback).
# P0_OVERVIEW_AI_PROVIDER=auto
# Optional Claude model just for overviews (empty = shared ANTHROPIC_MODEL). Set a Sonnet id for higher accuracy.
# P0_OVERVIEW_ANTHROPIC_MODEL=
#
# Optional override: **Send overview** to a *third* broadcast chat (wins over POST_TO_INCIDENT if both set).
# INCIDENT_OVERVIEW_SEND_MAP=oc_detection_a=oc_broadcast_a,...
#
# Two-bot compliance: primary bot posts to detection; broadcast goes via lark-forwarder (Overview bot app).
# Requires INCIDENT_OVERVIEW_SEND_MAP + P0_OVERVIEW_POST_TO_INCIDENT_SOURCE_CHAT=1 so primary never joins broadcast.
# LARK_OVERVIEW_FORWARDER_ENABLED=0
# LARK_OVERVIEW_FORWARDER_URL=http://127.0.0.1:8010
# LARK_OVERVIEW_FORWARDER_SECRET=change-me
# Forwarder side (lark-forwarder/.env): LARK_APP_ID + LARK_APP_SECRET (Overview bot app) + LARK_FORWARDER_BROADCAST_CHAT_ID=oc_...
# After deploy: restart lark-forwarder so POST returns message_id and PATCH /patch-overview updates the overview-bot card on Edit→Save.
# Webhook-only forwarder posts cannot be PATCHed — use the Overview Lark app credentials instead.
# Optional webhook fallback: LARK_FORWARDER_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/...
#
# --- Send overview: which Lark ``oc_`` receives the post (not the DM chat) ----
# Button context ``open_chat_id`` = DM with bot; that is NOT the overview destination.
# In ``send_preview`` payload: ``source_incident_chat_id`` = detection; ``target_chat`` = prompt (TARGET_MAP mirror).
# Final Lark group (first match wins): (1) INCIDENT_OVERVIEW_SEND_MAP[source], (2) source if
# P0_OVERVIEW_POST_TO_INCIDENT_SOURCE_CHAT=1, (3) ``target_chat``.
# Deployed bots: log line ``send_preview: Lark overview destination chat_id=oc_...`` = exact post target.
#
# Optional: when the primary **Send overview** post lands in a **detection** group (left-hand ``oc_`` of
# ``INCIDENT_OVERVIEW_TARGET_MAP``, or the source incident group when no map is set), also post the same
# card to extra group(s) — e.g. a PO notification room. Comma-separated. Bot must be in those chats.
# OVERVIEW_DETECTION_FANOUT_CHAT_IDS=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# (alias) P0_OVERVIEW_DETECTION_FANOUT_CHAT_IDS=
#
# --- Bitable deployment / ops cards (48h window) --------------------------------
# When **P0 is declared** (start_p0), the bot posts boss-style cards to the incident group:
#   🔴 线上操作汇总 (filters Rejected) + 📦 Deployment (paginated, 8 rows/page).
# Same cards also run after **Send overview** unless already posted on declare (dedupe via session flag).
# Window: **yesterday 00:00 (MYT) through end of today 23:59** — full 48h.
# P0_ADJUSTMENT_BITABLE_DEPLOY_MAX_ROWS=16
# P0_ADJUSTMENT_BITABLE_OPS_MAX_ROWS=8
# P0_ADJUSTMENT_BITABLE_DEPLOY_PAGE_SIZE=8
# P0_ADJUSTMENT_BITABLE_OPS_STATUS_FIELD=执行状况阶段
# P0_ADJUSTMENT_BITABLE_OPS_OPERATOR_FIELD=操作人员
# Deploy extra columns (optional): VERSION, PM, Email, Changelog — see config.py field map.
# P0_ADJUSTMENT_BITABLE_TIMEZONE=Asia/Kuala_Lumpur
# P0_ADJUSTMENT_BITABLE_TZ_LABEL=MYT
# All matching rows are shown (no row cap unless P0_ADJUSTMENT_BITABLE_MAX_ROWS is set > 0).
# Developer console: add scope **bitable:app:readonly** (or bitable:app) on the primary Lark app.
# P0_ADJUSTMENT_BITABLE_ENABLED=1
# P0_ADJUSTMENT_BITABLE_APP_TOKEN=LVrubE8f8af1yTslQgqlIaWPgcg
# P0_ADJUSTMENT_BITABLE_TABLE_ID=tblHHa3NmHmWian6
# P0_ADJUSTMENT_BITABLE_DOC_URL=https://casinoplus.sg.larksuite.com/base/LVrubE8f8af1yTslQgqlIaWPgcg?table=tblHHa3NmHmWian6&view=vewRD952Gw
# All columns on card — only for these table IDs (comma-separated). Default tblHHa3NmHmWian6 only.
# P0_ADJUSTMENT_BITABLE_ALL_FIELDS_TABLE_IDS=tblHHa3NmHmWian6
# P0_ADJUSTMENT_BITABLE_HOURS=48
# Deployments table column overrides (optional — window filter only):
# P0_ADJUSTMENT_BITABLE_BLUE_GREEN_TIME_FIELD=Blue Green Time
# P0_ADJUSTMENT_BITABLE_FULL_RELEASE_TIME_FIELD=Full Release Time
# P0_ADJUSTMENT_BITABLE_SERVICE_FIELD=Service
# P0_ADJUSTMENT_BITABLE_NAMESPACE_FIELD=Namespace
# P0_ADJUSTMENT_BITABLE_IMAGE_TAG_FIELD=Image Tag
# P0_ADJUSTMENT_BITABLE_PROJECT_FIELD=Project
# Second table — card title **线上操作** (tblTNzlhFdyrKgG8):
# P0_ADJUSTMENT_BITABLE_OPS_TABLE_ID=tblTNzlhFdyrKgG8
# Window check: 执行操作时间 / 执行完毕时间. Card shows: 执行操作, 执行操作时间, 项目, 执行原因, 执行完毕时间
# P0_ADJUSTMENT_BITABLE_OPS_DOC_URL=https://casinoplus.sg.larksuite.com/base/LVrubE8f8af1yTslQgqlIaWPgcg?table=tblTNzlhFdyrKgG8&view=vew3eqLIWs
# Ops column overrides (optional — defaults match Chinese headers above):
# P0_ADJUSTMENT_BITABLE_OPS_OPERATION_FIELD=执行操作
# P0_ADJUSTMENT_BITABLE_OPS_START_TIME_FIELD=执行操作时间
# P0_ADJUSTMENT_BITABLE_OPS_PROJECT_FIELD=项目
# P0_ADJUSTMENT_BITABLE_OPS_REASON_FIELD=执行原因
# P0_ADJUSTMENT_BITABLE_OPS_DONE_TIME_FIELD=执行完毕时间
# P0_ADJUSTMENT_BITABLE_ON_P0_DECLARE=1
# P0_ADJUSTMENT_BITABLE_THREAD_FOLLOWUPS=1
# Optional: fixed Lark group for 📦/🔴 cards (overrides incident/overview routing when set).
# Bot must be a member. Blank = same group as meeting cards (P0 declare) or overview post (Send).
# P0_ADJUSTMENT_BITABLE_POST_CHAT_ID=oc_your_bitable_hub_group
# P0_ADJUSTMENT_BITABLE_REPLY_IN_THREAD=1
# P0_ADJUSTMENT_BITABLE_ALSO_SEND_TO_GROUP=1
#
# --- VC cloud recording → extra group(s) (Open API reserves only; subscribe vc.meeting.recording_ready_v1) ---
# When a recording is ready, post an interactive **card** (topic + meeting ids + link button) to these ``oc_`` chats.
# Optionally also posts a compact ``RECORDING_READY`` text line for downstream Minutes bots.
# Default: card only. Set VC_RECORDING_FANOUT_PLAIN_META=1 if a downstream bot parses that text.
# Developer console: Events → subscribe **vc**.**meeting**.**recording_ready_v1**; scopes e.g. vc:meeting:readonly + vc:record:readonly.
# If you never see that event in logs, subscription/permissions may be missing — code also **polls** the recording API
# a few times after **vc.meeting.meeting_ended_v1**. Very short meetings (~under 5s) often have **no** cloud file.
# (alias) P0_VC_RECORDING_FANOUT_CHAT_IDS=
# VC_RECORDING_FANOUT_CHAT_IDS=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: only forward if topic contains this substring (case-insensitive), e.g. match VIDEO_MEETING_TOPIC_PREFIX:
# VC_RECORDING_FANOUT_TOPIC_SUBSTRING=Video meeting
# Grant **view** on the recording file to each fan-out group (API set_permission) so members who were not in the VC can open the link.
# Requires **vc:record** scope. Set to 0 if the call fails (e.g. user token required by tenant policy).
# VC_RECORDING_FANOUT_SET_PERMISSION=1
# Default off (interactive card only). Boss Minutes bot needs the text line? Set =1:
# VC_RECORDING_FANOUT_PLAIN_META=0
# If links still open as "Access restricted", optional **tenant-wide view** on the recording (broad — confirm compliance):
# VC_RECORDING_FANOUT_TENANT_WIDE_VIEW=1
# Optional: comma-separated **user** ``ou_...`` open_ids — same ``set_permission`` call adds **type=1** (user view)
# on the recording (like sharing the Minutes file to those users). Bot also **DMs** them the same link text.
# Use with or without ``VC_RECORDING_FANOUT_CHAT_IDS``. Requires **vc:record** (often **user_access_token** per Lark docs).
# (alias) P0_VC_RECORDING_FANOUT_USER_OPEN_IDS=
# VC_RECORDING_FANOUT_USER_OPEN_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# If you use P0_THREAD_CONFIRM_* and people reply in the **prompt** group, that ``oc_`` must be in INCIDENT_GROUP_IDS.

# Legacy / unused by core bot — safe to remove
LARK_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
P0_TARGET_GROUP_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- VC meeting host + DM (✎ isang duty user: host at DM pareho) --------------
# Simplest: one ou_ = Lark VC organizer (owner_id) AND DM recipient.
# (Fallback only if P0_OWNER_OPEN_IDS and P0_DM_INSTRUCTION_OPEN_* are blank.)
# P0_HOST_AND_DM_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Or separate: first ou_ = VC host; DM list below.
P0_OWNER_OPEN_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# o:
# P0_INVITEE_OPEN_IDS=ou_aaa,ou_bbb

# VC reserve ``end_time`` = now + this many seconds (Lark requires a time; Feishu docs cap ~30 days).
# Default if unset: 30 days (2592000) — not the old 2-hour window.
# P0_VC_RESERVE_END_OFFSET_SEC=2592000

# --- VC: auto-end meeting if nobody (except trigger) joins ----------------------------
# **Option A — only some incident groups** (comma-separated oc_): default 30 min (1800 s) each.
# P0_VC_AUTO_CANCEL_IF_NO_JOINS_CHAT_IDS=oc_aaa,oc_bbb
# P0_VC_AUTO_CANCEL_IF_NO_JOINS_CHAT_SEC=1800
# Only vc.meeting.join events with a user open_id (ou_...) count as "joined"; events without open_id do not block auto-cancel.
#
# **Option B — all incident groups**: set seconds (0 = off). Ignored when Option A list is non-empty
# for chats *not* in that list.
# P0_VC_AUTO_CANCEL_IF_NO_JOINS_SEC=1800
#
# Legacy aliases for Option A list: P0_EMERGENCY_TEST_GROUP_CHAT_ID, P0_EMERGENCY_TEST_GROUP_CHAT_IDS
# Legacy alias for Option A delay: P0_VC_AUTO_CANCEL_EMERGENCY_TEST_GROUP_SEC

# --- Ignore: cannot trigger p0/p1 in incident group (optional) ---------------
# Leave blank if nobody to ignore
P0_TRIGGER_IGNORE_OPEN_IDS=

# --- Thread confirm: duty asks "is this P0?" → someone replies with agreement (not only the word "yes") → start P0 (optional) ---
# Comma-separated ou_... of users who may *ask* (must include "?" in the question, e.g. "@Team is this P0?").
# Phrases like "is this issue is p0?" or "is this issue considered as p0?" also arm (extra words before the priority token).
# If **both** this and P0_THREAD_CONFIRM_TARGET_OPEN_IDS are blank, thread confirm is off.
# Replier must use **Reply** so Lark sends parent_id (same thread).
# P0_THREAD_CONFIRM_ASKER_OPEN_IDS=ou_duty_cp_om,ou_other
# Optional: ou_... of people who must be @mentioned for a *non-designated* asker to arm (e.g. QA / leads).
# Example: anyone can @Aldan @Sheng @QA @Miyu with "is this P0?" and it arms; duty users in ASKER_OPEN_IDS still arm without @.
# P0_THREAD_CONFIRM_TARGET_OPEN_IDS=ou_7faefd7f7af5e4006ef74c33bab61862,ou_d392218e8210ab3575f95144a0e1d003,ou_45127de5dfaf8027ce72fdc2331ff411,ou_5e6683f594c18c09b0db19670af220af
# Optional: only these users may reply with a confirming phrase to confirm (if blank: anyone except the asker).
# Set to 1 if the asker may confirm their own thread (same person asks + says yes). Default 0 = someone else must confirm.
# P0_THREAD_CONFIRM_ALLOW_ASKER_SELF_YES=0
# If 1: when armed and the reply does not match the regex allowlist, one Groq call classifies P0 approval (needs question_text stored on arm).
# P0_THREAD_CONFIRM_USE_GROQ=0
# If 1 (needs GROQ_API_KEY): after regex filters on ``p0`` keyword, one Groq call; proceed only if model says this line is a **real P0 declaration** (severity / escalation), not casual mention. Parse/API fail → fail-open (keyword still triggers).
# P0_KEYWORD_GROQ_GATE=0
# AI triage (default on): Claude → Gemini Flash → Groq classifies declare vs mention/handoff.
# P0_KEYWORD_AI_TRIAGE=1
# P0_KEYWORD_AI_PROVIDER=auto   # auto | claude | gemini | groq
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# GEMINI_API_KEY=               # https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.1-flash-lite   # or gemini-3.5-flash, gemini-3-flash-preview (see AI Studio)
# Smarter Groq fallback: GROQ_MODEL=llama-3.3-70b-versatile
# Default 1: use built-in heuristics (issue prose, in-meeting, polite/past asks). Set 0 to drop those and use Groq +/or supplemental regex below.
# P0_KEYWORD_USE_BUILTIN_CONTEXT_FILTERS=1
# Optional: extra skip regex (case-insensitive, DOTALL). If it matches anywhere in the message, keyword VC is skipped. Tune without redeploying code.
# P0_KEYWORD_SUPPLEMENTAL_SKIP_REGEX=
# P0_THREAD_CONFIRM_RESPONDER_OPEN_IDS=
# P0_THREAD_CONFIRM_TTL_SEC=3600
# Set to 1 if confirmers may type "yes" as a normal group message (not Reply / thread). Higher false-positive risk.
# P0_THREAD_CONFIRM_ALLOW_TOPLEVEL_YES=0
# Seconds after "is this P0?" where a plain top-level "yes" still counts (same conversation). After that, top-level
# yes must @mention the asker (ou_ in webhook mentions) or use Reply to the question. 0 = always require @ or Reply.
# P0_THREAD_CONFIRM_TOPLEVEL_GRACE_SEC=180

# --- Who receives DM “incident details” card (optional) ----------------------
# If blank: whoever typed p0/p1 — UNLESS P0_HOST_AND_DM_OPEN_ID is set above.
# Multiple: P0_DM_INSTRUCTION_OPEN_IDS=ou_a,ou_b,ou_c
# (OVERVIEW_DM_OPEN_ID / P0_DM_USER_OPEN_ID in old .env are NOT read by p0_logic;
#  use the two variables below if you use fixed recipients.)
P0_DM_INSTRUCTION_OPEN_ID=
# P0_DM_INSTRUCTION_OPEN_IDS=

# After Clear draft: a short DM text is always sent (“paste screenshots/text again”).
# This flag only controls whether the instruction *card* is reposted too (default off).
# Cancel preview always recalls the preview card and posts a fresh instruction card.
# P0_DM_REPOST_INSTRUCTION_AFTER_RESET=1

# --- Groq ---------------------------------------------------------------------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Anthropic Claude (Issue Watch, keyword triage, Grafana AI) ---------------
# Option A — Claude Code OAuth subscription (same as colleague's server; no API key):
#   1. Install Claude Code CLI, run once:  claude auth login
#   2. Credentials saved to ~/.claude/.credentials.json (auto refresh)
#   3. Leave ANTHROPIC_API_KEY blank; set P0_ANTHROPIC_PREFER_OAUTH=1 (default)
#   Or copy token to env:  claude setup-token  →  ANTHROPIC_AUTH_TOKEN=sk-ant-oat01-...
#   Server path override: CLAUDE_CREDENTIALS_PATH=/home/aiuser/.claude/.credentials.json
#
# Option B — Pay-as-you-go API key (console.anthropic.com):
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# P0_ANTHROPIC_PREFER_OAUTH=1   # use OAuth/auth-token before API key when both set (default on)
# ANTHROPIC_AUTH_TOKEN=          # optional Bearer from `claude setup-token`
# CLAUDE_CODE_OAUTH_TOKEN=       # alias for ANTHROPIC_AUTH_TOKEN
# CLAUDE_CREDENTIALS_PATH=       # default ~/.claude/.credentials.json
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# OAuth / setup-token: old Haiku id 404s — use OAuth-era model (auto-remapped in code if unset):
# ANTHROPIC_OAUTH_MODEL=claude-haiku-4-5-20251001
# Stronger Issue Watch on OAuth (needs Claude Code identity headers — handled in code):
# ANTHROPIC_OAUTH_MODEL=claude-sonnet-4-20250514
# Screenshot on-demand AI provider: auto (Claude if auth configured) | claude | groq
# P0_GRAPH_SCREENSHOT_AI_PROVIDER=claude

# --- HTTP ---------------------------------------------------------------------
REQ_TIMEOUT=10

# --- Support sheet (participants / support map) -------------------------------
SUPPORT_SHEET_SPREADSHEET_TOKEN=your_sheet_token
SUPPORT_SHEET_NAME=Sheet1
SUPPORT_SHEET_RANGE=A:B

# --- Wiki group AI ------------------------------------------------------------
WIKI_GROUP_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WIKI_DOC_TOKEN=your_wiki_doc_token
WIKI_HTTP_TIMEOUT=30

# --- Timing / behavior (p0_logic defaults if unset) ---------------------------
# P0_COOLDOWN_SEC=300
# AUTO_PREVIEW_DELAY_SEC=6
# ONGOING_CARD_DELAY_SEC=600
# P1_TO_P0_ESCALATION_SEC=900
# P0 ongoing DM buzz: Major 5 min / Minor 10 min — leadership reminder DMs
# P0_ONGOING_DM_BUZZ_ENABLED=1
# P0_ONGOING_DM_BUZZ_MAJOR_DELAY_SEC=300
# P0_ONGOING_DM_BUZZ_MINOR_DELAY_SEC=600
# P0_ONGOING_DM_BUZZ_DELAY_SEC=600
# P0_ONGOING_CONTACT_NAMES=Greg, Eason and Rock
# Lark native buzz (加急) on that DM card: app (default), phone, sms, or off
# P0_ONGOING_LARK_URGENT_MODE=app

# --- Legacy / unused by current p0_logic/main.py ------------------------------
# (Safe to keep for other branches/tools; no effect on core bot.)
P0_DM_INVITE=1
OVERVIEW_DM_OPEN_ID=
P0_DM_USER_OPEN_ID=
AUTO_POST_OVERVIEW_CARD=0
DM_OCR_ENABLED=1
HEADFUL_ONCE=0
FORCE_SHOW_TEST_CARDS=false

# --- Optional: topic ng VC (may default sa config) ------------------------------
# MEETING_TOPIC="CP-Emergency feedback紧急问题反馈群"

# --- P0 Grafana (or any) dashboard screenshot → Lark group (Playwright, OPTIONAL) ---
# When P0 starts: headless Chromium opens ``P0_GRAPH_SCREENSHOT_URL``, uploads PNG to Lark, posts to ``P0_GRAPH_SCREENSHOT_TARGET_CHAT_ID``.
#
# **Grafana auth (pick one):**
#   (A) Auto-login each run — set username/password (recommended if profile keeps logging out):
# P0_GRAPH_SCREENSHOT_USERNAME=om_duty
# P0_GRAPH_SCREENSHOT_PASSWORD=your_password_here
#   (B) Persistent profile — log in once with ``features/screenshot/scripts/grafana_playwright_login_once.py`` (headed).
# P0_GRAPH_SCREENSHOT_PLAYWRIGHT_USER_DATA_DIR=/var/lib/lark-ops-ai/grafana-playwright-profile
#
# **Two Lark images (top of board + scrolled to bottom):**
# P0_GRAPH_SCREENSHOT_VIEWPORT_ONLY=1
# P0_GRAPH_SCREENSHOT_TOP_AND_BOTTOM=1
# P0_GRAPH_SCREENSHOT_VIEWPORT_SCROLL_COUNT=2
# P0_GRAPH_SCREENSHOT_SPLIT_VERTICAL_HALVES=0
# P0_GRAPH_SCREENSHOT_ZOOM_PERCENT=50
# P0_GRAPH_SCREENSHOT_KIOSK=1
# **Browser zoom** (e.g. 50 %) is persisted in that profile: it changes viewport density, scroll
# metrics, and virtualized panel behaviour. Use a fixed zoom (100 % is simplest) so crops/splits stay predictable.
# Grafana TV/kiosk: default **on** — bot appends ``kiosk=tv`` if missing (hides left nav). Set ``P0_GRAPH_SCREENSHOT_KIOSK=0`` to skip.
# Optional: CSS selector(s) for dashboard body (comma-separated). **First match with a large enough visible box** wins; narrow ``.scrollbar-view`` gutters are skipped (otherwise Lark gets blank gray images). Use ``-`` to disable clipping (whole page).
# P0_GRAPH_SCREENSHOT_KIOSK=1
# P0_GRAPH_SCREENSHOT_CLIP_SELECTOR=main .scrollbar-view,main
#
# **Big multi-panel dashboards** (full grid, like Core Metrics): widen the viewport (e.g. 1920×1080). Raise ``WAIT_MS`` (e.g. 10000–18000)
# so queries can render **filled** graphs. Set ``PANEL_READY_TIMEOUT_MS`` (e.g. 25000–35000) so panels mount.
# ``GOTO_WAIT_UNTIL``: load | domcontentloaded | commit | networkidle (avoid networkidle on Grafana unless you know it idles).
#
# Install: ``pip install playwright`` (see p0_logic/requirements.txt) and ``playwright install chromium``.
# Lark app needs permission to upload images (e.g. im:resource) and post to the target group.
# P0_GRAPH_SCREENSHOT_ENABLED=0
# P0_GRAPH_SCREENSHOT_URL=https://grafana.example.com/d/uid/slug?orgId=1&kiosk
# P0_GRAPH_SCREENSHOT_TARGET_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# P0_GRAPH_SCREENSHOT_PLAYWRIGHT_USER_DATA_DIR=/var/lib/lark-ops-ai/grafana-playwright-profile
# P0_GRAPH_SCREENSHOT_GOTO_WAIT_UNTIL=load
# P0_GRAPH_SCREENSHOT_WAIT_MS=10000
# Wait for Grafana panel grid DOM before WAIT_MS (fixes black/empty main area when load is too early). 0=off.
# P0_GRAPH_SCREENSHOT_PANEL_READY_TIMEOUT_MS=30000
# After grid exists, wait for canvas/SVG or panel text (auto if PANEL_READY>0: max(45s, panel_ready+25s); or set explicitly).
# P0_GRAPH_SCREENSHOT_PANEL_CONTENT_READY_TIMEOUT_MS=60000
# P0_GRAPH_SCREENSHOT_VIEWPORT_WIDTH=1920
# P0_GRAPH_SCREENSHOT_VIEWPORT_HEIGHT=1080
# Sharper PNGs in chat (2× device pixels per CSS px); bigger files — good if Lark downscales and text looks muddy.
# P0_GRAPH_SCREENSHOT_DEVICE_SCALE_FACTOR=2
# P0_GRAPH_SCREENSHOT_NAV_TIMEOUT_MS=120000
# P0_GRAPH_SCREENSHOT_FULL_PAGE=1
#
# --- How to frame the PNG(s) ---
# **A) Lark: multiple viewport shots while scrolling** (long Grafana dashboards — use 3–4 if each pic is too full):
#     P0_GRAPH_SCREENSHOT_VIEWPORT_ONLY=1
#     P0_GRAPH_SCREENSHOT_SPLIT_VERTICAL_HALVES=1
#     P0_GRAPH_SCREENSHOT_VIEWPORT_SCROLL_COUNT=3
#     P0_GRAPH_SCREENSHOT_FULL_DOCUMENT=0
#     (Unset SCROLL_COUNT → 2 when SPLIT=1. If nothing scrolls, falls back to Pillow halving one viewport.)
# **B) Entire scrollable page** (very tall; can look empty): P0_GRAPH_SCREENSHOT_FULL_DOCUMENT=1
#
# Scrolling capture: VIEWPORT_ONLY + SPLIT (+ optional SCROLL_COUNT); else Playwright clips / Pillow.
# P0_GRAPH_SCREENSHOT_SPLIT_VERTICAL_HALVES=1
# Linux/Docker: comma-separated Chromium flags if launch fails (e.g. --no-sandbox)
# P0_GRAPH_SCREENSHOT_CHROMIUM_ARGS=--no-sandbox,--disable-dev-shm-usage
# Black screenshots on Linux VPS: SwiftShader is **on by default** when unset (see config). Force off: P0_GRAPH_SCREENSHOT_SWIFTSHADER=0
# P0_GRAPH_SCREENSHOT_SWIFTSHADER=1
# VIEWPORT_ONLY: one browser window shot (no CSS clip). Use with SPLIT for two Lark images. Prefer over FULL_DOCUMENT for chat.
# P0_GRAPH_SCREENSHOT_VIEWPORT_ONLY=1
# If capture is uniformly dark, retry viewport-only (default on). Off: P0_GRAPH_SCREENSHOT_BLANK_FALLBACK_VIEWPORT=0
# IANA timezone for ``{captured_at}`` (default Malaysia: Asia/Kuala_Lumpur / MYT). Use UTC for UTC.
# P0_GRAPH_SCREENSHOT_TIMEZONE=Asia/Kuala_Lumpur
# Text before the image. Placeholders: ``{label}`` = source chat name, ``{captured_at}`` = when the PNG was taken.
# If unset, only a line ``As of: <date time>`` is posted before the image.
# P0_GRAPH_SCREENSHOT_CAPTION=📊 Graph snapshot — P0 ({label}) · As of: {captured_at}
# Manual capture: ``python3 features/screenshot/scripts/grafana_screenshot_run_once.py`` (saves PNGs only). To also post: ``python3 features/screenshot/scripts/grafana_screenshot_run_once.py --post-lark``

# =============================================================================
# Copy-paste block — Grafana P0 (image 1 = top of board, image 2 = after scroll ~1 viewport)
# (Replace TARGET_CHAT_ID / URL / profile. Pillow: optional fallback if no scroll.)
# =============================================================================
# P0_GRAPH_SCREENSHOT_ENABLED=1
# P0_GRAPH_SCREENSHOT_URL=https://grafana.client8.me/d/281e8816-ccb0-4335-922b-6b248491fd28/core-metrics-arms-aliyun?orgId=1&from=now-6h&to=now&timezone=browser&refresh=1m
# P0_GRAPH_SCREENSHOT_USERNAME=om_duty
# P0_GRAPH_SCREENSHOT_PASSWORD=your_password_here
# P0_GRAPH_SCREENSHOT_TARGET_CHAT_ID=oc_cc9857165a236f6c101ba74e3c2f1deb
# P0_GRAPH_SCREENSHOT_VIEWPORT_ONLY=1
# P0_GRAPH_SCREENSHOT_TOP_AND_BOTTOM=1
# Pic 1: Last 6h / refresh bar + full Apisix Error Count graph at top
# P0_GRAPH_SCREENSHOT_INCLUDE_TIME_BAR=1
# P0_GRAPH_SCREENSHOT_SPLIT_VERTICAL_HALVES=0
# P0_GRAPH_SCREENSHOT_VIEWPORT_SCROLL_COUNT=2
# P0_GRAPH_SCREENSHOT_ZOOM_PERCENT=50
# P0_GRAPH_SCREENSHOT_KIOSK=1
# Do not set FULL_DOCUMENT=1 for chat framing (whole scroll = very tall / often empty).
# P0_GRAPH_SCREENSHOT_PANEL_READY_TIMEOUT_MS=30000
# P0_GRAPH_SCREENSHOT_WAIT_MS=15000
# P0_GRAPH_SCREENSHOT_GOTO_WAIT_UNTIL=load
# P0_GRAPH_SCREENSHOT_NAV_TIMEOUT_MS=120000
# Ops: if charts are often blank, add: P0_GRAPH_SCREENSHOT_PANEL_CONTENT_READY_TIMEOUT_MS=60000
#
# --- Faster capture (TOP_AND_BOTTOM=1, 2×1920×1080) — accuracy OK, less waiting ---
# With TOP_AND_BOTTOM the bot skips the long global ``PANEL_CONTENT`` wait (per-band waits instead).
# P0_GRAPH_SCREENSHOT_PANEL_READY_TIMEOUT_MS=25000
# P0_GRAPH_SCREENSHOT_WAIT_MS=5000
# P0_GRAPH_SCREENSHOT_BAND_MAX_WAIT_MS=25000
# P0_GRAPH_SCREENSHOT_FAST_CAPTURE=1
# (default on — auto P0 uses same fast band waits as on-demand chat requests)
# P0_GRAPH_SCREENSHOT_BAND_WARM_SCROLL=1
# Repeat screenshots every N minutes while P0 is active; 0 = only when P0 starts.
# P0_GRAPH_SCREENSHOT_INTERVAL_MIN=20
# Wall-clock cap for auto P0 capture (posts failure text to target chat if exceeded). Default 600s.
# P0_GRAPH_SCREENSHOT_AUTO_MAX_SEC=600
#
# Auto on P0 (and each interval): default **6h** only (one band set per trigger).
# ``from=`` is set on P0_GRAPH_SCREENSHOT_URL per range. ``3h`` / ``1h`` / ``30m`` = on-demand chat only.
# P0_GRAPH_SCREENSHOT_AUTO_RANGES=6h
#
# On-demand Grafana only in screenshot hub (P0_GRAPH_SCREENSHOT_TARGET_CHAT_ID), not every incident group.
# Typed requests e.g. "screenshot last 30 min", "@bot please give 30 mins".
# P0_GRAPH_SCREENSHOT_ON_DEMAND=1
# Optional extra allowed groups (default: TARGET_CHAT_ID only):
# P0_GRAPH_SCREENSHOT_ON_DEMAND_CHAT_IDS=oc_aaa,oc_bbb
# On-demand speed (chat requests like ``please give 30 mins``) — default fast + warm browser:
# P0_GRAPH_SCREENSHOT_ON_DEMAND_FAST=1
# P0_GRAPH_SCREENSHOT_BROWSER_POOL=1
# (auto-on when PLAYWRIGHT_USER_DATA_DIR is set — skips ~30–60s cold Chromium launch on repeat P0)
# P0_GRAPH_SCREENSHOT_ON_DEMAND_BAND_MAX_WAIT_MS=28000
# P0_GRAPH_SCREENSHOT_ON_DEMAND_BAND_STABLE_POLLS=2
# Stricter capture: wait until panels painted (not black/loading). Defaults: 88% ready, 0 blanks, 3 stable polls.
# P0_GRAPH_SCREENSHOT_BAND_PANEL_READY_RATIO=0.88
# P0_GRAPH_SCREENSHOT_BAND_MAX_BLANK_PANELS=0
# P0_GRAPH_SCREENSHOT_BAND_STABLE_POLLS=3
# P0_GRAPH_SCREENSHOT_ON_DEMAND_FAST=0
# Emoji reactions on the requester's message (OTE-AI style). Needs im:message.reactions:write_only
# P0_GRAPH_SCREENSHOT_REACT=1
# P0_GRAPH_SCREENSHOT_REACT_QUEUED=OnIt
# P0_GRAPH_SCREENSHOT_REACT_DONE=DONE
# P0_GRAPH_SCREENSHOT_REACT_FAILED=ERROR
# Requires logged-in profile for pool (biggest win):
# P0_GRAPH_SCREENSHOT_PLAYWRIGHT_USER_DATA_DIR=/var/lib/lark-ops-ai/grafana-playwright-profile
# Natural language + AI (OTE-AI style): ``please give 30 mins``, ``@bot 1hr``.
# P0_GRAPH_SCREENSHOT_AI=1
# P0_GRAPH_SCREENSHOT_AI_PROVIDER=claude
#   auto (default) = Claude if ANTHROPIC_API_KEY set, else Groq; or force claude | groq
# P0_GRAPH_SCREENSHOT_BOT_MENTION_HINTS=P1/P0-automation-bot,automation-bot
# Caption may use {range} and {captured_at}; default adds "Last 6 hours" etc.
# Optional — leave unset for default: As of: {captured_at} · Last {range}
# P0_GRAPH_SCREENSHOT_CAPTION=As of: {captured_at} · Last {range}
# P0_THREAD_CONFIRM_USE_GROQ=1

# --- Detection group issue watch (Claude → DM duty, same recipients as overview) ---
# Watches ``INCIDENT_GROUP_IDS`` for player-facing issues (login, deposit, FPMS down, etc.).
# DMs ``P0_DM_INSTRUCTION_OPEN_IDS`` (or ``P0_DM_INSTRUCTION_OPEN_ID``) — same route as P0 overview card.
# Major alert DM can include **Declare as P0** / **Not now** (reply on concern + react + start_p0 + overview DM).
# P0_ISSUE_WATCH_DECLARE_P0_ENABLED=1
# Groq writes the thread reply (category, player count, why P0). Fallback when AI off/fails:
# P0_ISSUE_WATCH_DECLARE_REPLY_AI=1
# P0_ISSUE_WATCH_DECLARE_REPLY_TEXT=We will declare this issue as P0.
# P0_ISSUE_WATCH_DECLARE_REACTION=OnIt
# P0_ISSUE_WATCH_DECLARE_REPLY_IN_THREAD=1
# Also post the same declare text to the main group feed (like Lark "Also send to the group")
# P0_ISSUE_WATCH_DECLARE_ALSO_SEND_TO_GROUP=1

# Major P0 declare — direct check-person invite (replaces @-tag thread confirm when set)
# u_... is treated as ou_... (common typo). Use dev-app open_ids on dev server.
# P0_MAJOR_CHECK_PERSON_IDS=ou_1bbecc2487d8ca9503aa652553a9482b,ou_af576e6a273483f2a1f963afbc265a76
# Cherng Shen + Yuxuan (comma-separated). Do NOT put duty open_id here.
# With P0_VC_RING_ENABLED=1, these users are also rung into VC when duty joins (not DM-only).
# Second thread reply after declare-as-P0 (plain text only — no @mentions):
# P0_ISSUE_WATCH_DECLARE_CHECK_PERSON_REPLY_TEXT=Calling and inviting the check persons for major P0 issues. Thank you.
# Invite = VC ring when duty joins (default). Optional link DM — off unless you set:
# P0_MAJOR_CHECK_PERSON_DM_ENABLED=0
# P0_MAJOR_CHECK_PERSON_DM_TEXT=Major P0 declared — please join the bridge meeting: {link}
# P0_MAJOR_CHECK_PERSON_JOIN_THREAD_TEXT={name} is already in the P0 meeting.
# P0_THREAD_CONFIRM_ALLOW_TARGET_MENTIONS=0
# P0_ISSUE_WATCH_ENABLED=1
# Major P0 detection scope: login, games/events entry, withdrawal, deposit, promotion/voucher,
# rebate, LuckyCoin, company/financial loss (+ website/backend/registration).
# P0_ISSUE_WATCH_AI_PROVIDER=auto
# auto (default): Claude if ANTHROPIC_API_KEY set, else Groq; Claude fail → Groq → keyword rules
# claude: Claude first, then Groq on fail, then keyword rules
# groq: Groq first, then Claude on fail, then keyword rules
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# P0_ISSUE_WATCH_MIN_CONFIDENCE=0.88
# P0_ISSUE_WATCH_MIN_SOLO_REPORTERS=2
# P0_ISSUE_WATCH_WINDOW_MIN=60
# P0_ISSUE_WATCH_MIN_REPORTS=4
# P0_ISSUE_WATCH_MIN_AFFECTED_PLAYERS=3
# P0_ISSUE_WATCH_COOLDOWN_MIN=20
# P0_ISSUE_WATCH_MIN_TEXT_LEN=15
# Major alert DM: **Use suggested overview** (auto draft) vs **Build overview manually** (green card).
# P0_ISSUE_WATCH_AUTO_OVERVIEW=1
# Lark 加急 (buzz) on Major detection alert DM — same modes as P0_ONGOING_LARK_URGENT_MODE
# P0_ISSUE_WATCH_BUZZ_ENABLED=1
# P0_ISSUE_WATCH_LARK_URGENT_MODE=app
# P0_ISSUE_WATCH_ID_WAIT_SEC=40
