# =============================================================================
# lark-ops-ai — buong .env template
# Kopyahin: cp env.example .env   tapos punan ang values.
# PROD: palitan ang mga may tsek (✎) — lalo na group ids at secrets.
# =============================================================================

# --- Lark app (✎ PROD: i-rotate ang secret kung na-leak sa chat/log) ----------
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=your_app_secret_here
LARK_ENCRYPT_KEY=your_encrypt_key_here
# Lark app permissions: bot needs im:message + im:message:send_as_bot + im:message:update
# so the red “Join meeting” card can be PATCHed closed when the VC ends (removes join link in-place).
# For “Cancel preview”: bot recalls the preview card via DELETE message — add im:message:recall if required by your tenant.

# Open Platform API base (must end with …/open-apis). Default SG; p0_logic reads LARK_OPEN_API_BASE.
# LARK_BASE_URL below is legacy / unused by p0_logic — use LARK_OPEN_API_BASE to override.
LARK_BASE_URL=https://open-sg.larksuite.com
# LARK_OPEN_API_BASE=https://open-sg.larksuite.com/open-apis

# --- Path ng .env sa server (✎ dapat tama ang absolute path) ----------------
ENV_PATH=/home/ubuntu/lark-ops-ai/.env

# --- Incident / P0-P1 routing (✎ PROD: bagong group = bagong oc_...) ---------
# One or more incident groups (comma-separated). P0/P1 works in ANY of these chats.
# Prefer INCIDENT_GROUP_IDS for multiple; or use INCIDENT_GROUP_ID=oc_a,oc_b
INCIDENT_GROUP_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# INCIDENT_GROUP_IDS=oc_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa,oc_bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb

# Optional: per-group line for meeting cards ``🚨 P0 — …`` + Lark VC topic (comma-separated oc_=text)
# INCIDENT_GROUP_EMERGENCY_TOPICS=oc_aaa=CP-Emergency feedback紧急问题反馈群,oc_bbb=Game urgent-游戏紧急群
# Kung walang match, ginagamit ang MEETING_TOPIC sa baba.
#
# DM command ``create overview emergency|game`` (no meeting): optional explicit routing:
# P0_STANDALONE_OVERVIEW_TAGS=emergency=oc_aaa,game=oc_bbb
# (Kung blanko: auto-match sa labels — "emergency" sa topic → emergency; "game" o 游戏 → game.)

# Optional: lahat ng "Send overview" dito mag-post (fixed channel). Kung blanko: sa group kung saan nag-start ang session.
# OVERVIEW_TARGET_GROUP_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# (alias) P0_OVERVIEW_POST_CHAT_ID=

# Legacy / hindi na ginagamit ng core bot — puwedeng tanggalin
LARK_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
P0_TARGET_GROUP_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- VC meeting host + DM (✎ isang duty user: host at DM pareho) --------------
# Pinakamadali: isang ou_ = Lark VC organizer (owner_id) AT siya rin makakatanggap ng DM.
# (Fallback lang ito kung blanko ang P0_OWNER_OPEN_IDS at P0_DM_INSTRUCTION_OPEN_*.)
# P0_HOST_AND_DM_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# O hiwalay: unang ou_ = VC host; DM list sa baba.
P0_OWNER_OPEN_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# o:
# P0_INVITEE_OPEN_IDS=ou_aaa,ou_bbb

# VC reserve ``end_time`` = now + this many seconds (Lark requires a time; Feishu docs cap ~30 days).
# Default if unset: 30 days (2592000) — not the old 2-hour window.
# P0_VC_RESERVE_END_OFFSET_SEC=2592000

# --- Ignore: hindi makakapag-trigger ng p0/p1 sa incident group (optional) ----
# Iwanang blanko kung wala pang i-ignore
P0_TRIGGER_IGNORE_OPEN_IDS=

# --- Sino makakatanggap ng DM “incident details” card (optional) --------------
# Kung blanko: yung nag-type ng p0/p1 ang makakatanggap — MALIBAN kung may P0_HOST_AND_DM_OPEN_ID sa taas.
# Maramihan: P0_DM_INSTRUCTION_OPEN_IDS=ou_a,ou_b,ou_c
# (Ang OVERVIEW_DM_OPEN_ID / P0_DM_USER_OPEN_ID sa lumang .env HINDI na binabasa ng p0_logic;
#  gamitin ang dalawa sa baba kung fixed recipient kayo.)
P0_DM_INSTRUCTION_OPEN_ID=
# P0_DM_INSTRUCTION_OPEN_IDS=

# After Clear draft: a short DM text is always sent (“paste screenshots/text again”).
# This flag only controls whether the instruction *card* is reposted too (default off).
# Cancel preview always recalls the preview card and posts a fresh instruction card.
# P0_DM_REPOST_INSTRUCTION_AFTER_RESET=1

# --- Groq ---------------------------------------------------------------------
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- HTTP ---------------------------------------------------------------------
REQ_TIMEOUT=10

# --- Support sheet (participants / support map) -------------------------------
SUPPORT_SHEET_SPREADSHEET_TOKEN=your_sheet_token
SUPPORT_SHEET_NAME=Sheet1
SUPPORT_SHEET_RANGE=A:B

# --- Wiki group AI ------------------------------------------------------------
WIKI_GROUP_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WIKI_DOC_TOKEN=your_wiki_doc_token
WIKI_HTTP_TIMEOUT=30

# --- Timing / behavior (p0_logic defaults kung wala) --------------------------
# P0_COOLDOWN_SEC=300
# AUTO_PREVIEW_DELAY_SEC=6
# ONGOING_CARD_DELAY_SEC=600
# P1_TO_P0_ESCALATION_SEC=900

# --- Legacy / hindi ginagamit ng kasalukuyang p0_logic/main.py ----------------
# (Pwede mong iwan kung may ibang branch/tool; safe na walang epekto sa core bot.)
P0_DM_INVITE=1
OVERVIEW_DM_OPEN_ID=
P0_DM_USER_OPEN_ID=
AUTO_POST_OVERVIEW_CARD=0
DM_OCR_ENABLED=1
HEADFUL_ONCE=0
FORCE_SHOW_TEST_CARDS=false

# --- Optional: topic ng VC (may default sa config) ------------------------------
# MEETING_TOPIC=CP-Emergency feedback紧急问题反馈群

# --- Slack + Playwright Huddle automation (OPTIONAL) ---
#
# SPEC — Gawin nang sunud-sunod / Do these in order (same venv na magpapatakbo ng bot o ng script):
#
#   (1) Python deps (required):
#         .venv/bin/python -m pip install -r scripts/requirements-huddle.txt
#       Dapat may playwright-stealth; kung wala, white about:blank ang huddle pop-out madalas.
#
#   (2) Browser binary (required on server/VNC):
#         playwright install chromium
#       o kung manual Chrome ang gumagana sa iyo, itakda ang CHROME_PATH at itugma ang UA (step 4).
#
#   (3) Login once into SESSION_DIR (same CHROME_PATH na gagamitin sa huddle):
#         export SESSION_DIR=... SLACK_CHANNEL_URL=...  # optional: CHROME_PATH=...
#         .venv/bin/python scripts/slack_open_login_browser.py
#
#   (4) User-Agent (strongly recommended kung may CHROME_PATH):
#       Kunin ang buong UA mula sa chrome://version sa parehong Chrome; ilagay sa SLACK_CHROME_USER_AGENT
#       (dapat magkatugma ang major Chrome version sa binary — kung hindi, mukhang bot).
#
#   (5) VNC / headed debugging:
#       Huwag mag-set ng SLACK_HEADLESS=1 o HEADLESS=1. Siguraduhing may DISPLAY (hal. :1) sa session.
#       One-shot (repo root):  bash scripts/run_slack_huddle_vnc.sh
#       (unsets SLACK_HEADLESS, sets DISPLAY default :1, sources .env, runs slack_huddle_invite_all.py)
#
#   (6) Bot subprocess (kung bot ang tumatawag):
#       Itakda ang SLACK_SUBPROCESS_PYTHON sa parehong .venv/bin/python na may playwright-stealth.
#
# Required env kapag tumatakbo ang scripts/slack_huddle_invite_all.py:
#   SESSION_DIR       — persistent Chromium profile (login dito naka-save)
#   SLACK_CHANNEL_URL — full channel URL (T.../C...)
#
# Optional pero karaniwang kailangan sa cloud Linux:
#   CHROME_PATH — system Chrome (hindi bundled Chromium). Kung ano ang nasa PATH:
#     which google-chrome   # hal. /usr/bin/google-chrome
#     which google-chrome-stable   # hal. /usr/bin/google-chrome-stable (madalas sa .deb install)
#   Parehong okay; dapat tugma ang SLACK_CHROME_USER_AGENT sa major version ng binary na ito.
#   SLACK_CHROME_USER_AGENT=<paste from chrome://version>
#   DISPLAY=:1
#   SLACK_SUBPROCESS_PYTHON=/path/to/lark-ops-ai/.venv/bin/python
#
# Optional — Chrome flags (advanced):
#   SLACK_CHROME_DISABLE_GPU=1 — force --disable-gpu even when headed (default: GPU on for headed/VNC)
#   SLACK_CHROME_OMIT_DISABLE_SETUID_SANDBOX=1 — do not pass --disable-setuid-sandbox (try as non-root only;
#     may silence the "unsupported flag" warning; NOT a fix for white huddle by itself)
#
# Old setup (puppeteer) note: SESSION_DIR + SLACK_CHANNEL_URL same idea; SLACK_SESSION_DIR optional alias.
#   - SLACK_CHANNEL_URL is used if you do NOT set LARK_SLACK_CHANNEL_URL_MAP (incident chat_id in INCIDENT_GROUP_IDS).
# Multi-channel: LARK_SLACK_CHANNEL_URL_MAP=oc_aaa=https://app.slack.com/...,oc_bbb=...
#
# Legacy (one Slack channel for all incident groups) — halimbawa:
# SESSION_DIR=/home/ubuntu/lark-ops-ai/puppeteer/slack_session_new
# SLACK_CHANNEL_URL=https://app.slack.com/client/T012345/C012345
#
# Non-English "invite" button text — extra substrings to match:
# SLACK_INVITE_MATCH_EXTRA=imbitahan,invitar
#
# Stealth: default ON (required dependency). Only if intentional:
# SLACK_PLAYWRIGHT_STEALTH_DISABLE=1
# SLACK_ALLOW_NO_STEALTH=1
#
# User-Agent override (retail Chrome string; unset = script default — still set real Chrome version if using CHROME_PATH):
# SLACK_CHROME_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36
# SLACK_CHROME_USER_AGENT_DISABLE=1
#
# Multi (per Lark oc_ → different Slack channel):
# LARK_SLACK_CHANNEL_URL_MAP=oc_aaa=https://app.slack.com/...,oc_bbb=https://...
# SLACK_SESSION_DIR=/path   # optional; defaults to SESSION_DIR if unset
#
# --- Slack Web API (lark-ops-ai → chat.postMessage — same auth idea as a normal Slack bot) ---
# You do NOT put App ID in API requests; you need:
#   (1) Bot User OAuth Token  (2) Channel ID per destination  (3) optional Bot Member ID to @mention
#
# Setup: https://api.slack.com/apps → your app → OAuth & Permissions → Bot User OAuth Token (xoxb-...).
# Scopes: chat:write. Reinstall app after adding scopes. In each Slack channel: /invite @YourBot
#
# SLACK_BOT_TOKEN=xoxb-...
#
# Channel ID (C...): Slack desktop → open channel → channel name → View channel details → copy ID at bottom.
# SLACK_API_CHANNEL_MAP=oc_f4e833c6744e55eb50dfcd8830fa913e=C0AR3JYATQF,oc_9dcd7343467c43db08d7c22d332c6532=C0APAFXN2H1
#
# Optional — ping the bot on every outgoing line (Member ID U..., not App ID): open bot profile → Copy member ID
# SLACK_BOT_USER_ID=U0xxxxxxx
# Or full custom first line (overrides SLACK_BOT_USER_ID), e.g. channel notify:  SLACK_MESSAGE_PREFIX=<!channel>
# SLACK_MESSAGE_PREFIX=
#
# SLACK_APP_ID=A0xxxx   # optional notebook field only; not required for posting
#
# Incoming Webhook when P0/P1 is declared (used only if Web API above is not configured).
# If unset, falls back to SLACK_OVERVIEW_WEBHOOK_MAP.
# SLACK_INCIDENT_NOTIFY_WEBHOOK_MAP=oc_aaa=https://hooks.slack.com/services/...,oc_bbb=...
#
# Overview text to Slack (OPTIONAL — only if you want Lark \"Send overview\" mirrored to Slack):
# SLACK_OVERVIEW_WEBHOOK_MAP=oc_aaa=https://hooks.slack.com/services/...,oc_bbb=...
# SLACK_AUTOMATION_ENABLED=1
# SLACK_HUDDLE_ON_P0_START=1
# SLACK_HUDDLE_ON_OVERVIEW_SEND=1
#
# --- Remote Playwright worker (recommended if cloud WebRTC/huddle is flaky) ---
# Bot POSTs JSON to this URL instead of running slack_huddle_invite_all.py on the same host.
# Run ``scripts/slack_huddle_remote_worker.py`` on a PC/Mac with a working SESSION_DIR + Playwright;
# put HTTPS (nginx/Caddy) in front; set the same SLACK_HUDDLE_REMOTE_SECRET on bot and worker.
# SLACK_HUDDLE_REMOTE_URL=https://huddle-worker.yourdomain.com/huddle
# SLACK_HUDDLE_REMOTE_SECRET=long-random-shared-secret
#
# Subprocess must use a Python that has ``pip install playwright`` (same venv as the bot if needed).
# SLACK_SUBPROCESS_PYTHON=/home/ubuntu/lark-ops-ai/.venv/bin/python
#
# CHROME_PATH=/snap/bin/chromium
# SCREENSHOT_DIR=/home/ubuntu/lark-ops-ai/puppeteer/screenshots
# HARD_TIMEOUT_MS=180000
# Playwright subprocess log (stdout+stderr); default: lark-ops-ai/logs/slack_huddle_playwright.log
# SLACK_PLAYWRIGHT_LOG=/home/ubuntu/lark-ops-ai/logs/slack_huddle_playwright.log
