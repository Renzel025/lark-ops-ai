# =============================================================================
# lark-ops-ai — PRODUCTION (OSE-bot)
# Copy:  cp env.prod.example /root/lark-ops-ai/.env
# Fill secrets from Lark console / Groq / Anthropic. Do NOT commit real .env.
# No inline comments on the same line as values (breaks some parsers).
# Issue Watch + VC ring: OFF below (as requested).
# =============================================================================

ENV_PATH=/root/lark-ops-ai/.env

# --- Lark primary bot (prod app) ---
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=your_primary_app_secret
LARK_ENCRYPT_KEY=your_primary_encrypt_key

# --- Lark severity bot ---
LARK_SEVERITY_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_SEVERITY_APP_SECRET=your_severity_app_secret
LARK_ENCRYPT_KEY_2=your_severity_encrypt_key
P0_SEVERITY_PROMPT_ENABLED=1

REQ_TIMEOUT=10

# --- Incident routing (prod groups) ---
P0_SINGLE_INCIDENT_GROUP=1
INCIDENT_GROUP_IDS=oc_cp_emergency_group_id,oc_game_urgent_group_id
INCIDENT_GROUP_EMERGENCY_TOPICS="oc_cp_emergency_group_id=CP-Emergency feedback紧急问题反馈群,oc_game_urgent_group_id=Game urgent-游戏紧急群"

P0_TRIGGER_IGNORE_OPEN_IDS=
P0_OWNER_OPEN_IDS=ou_duty_host_open_id
P0_DM_INSTRUCTION_OPEN_ID=ou_duty_host_open_id
P0_SHARED_STATE_DIR=/var/lib/lark-ops-ai-state
P0_GROUP_OVERVIEW_EDIT_ENABLED=1

# --- AI ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
GEMINI_API_KEY=your_gemini_key_if_used
GEMINI_MODEL=gemini-3.1-flash-lite
P0_KEYWORD_AI_PROVIDER=auto

# --- P0 keyword gates (prod) ---
P0_KEYWORD_GROQ_GATE=1
P0_KEYWORD_AI_TRIAGE=1

# --- Wiki / support sheet ---
WIKI_GROUP_CHAT_ID=oc_wiki_group_id
WIKI_DOC_TOKEN=your_wiki_doc_token
SUPPORT_SHEET_SPREADSHEET_TOKEN=your_support_sheet_token
SUPPORT_SHEET_NAME=Sheet1
SUPPORT_SHEET_RANGE=A:B

# --- Thread confirm ---
P0_THREAD_CONFIRM_TARGET_OPEN_IDS=ou_qa1,ou_qa2,ou_qa3,ou_qa4,ou_qa5
P0_THREAD_CONFIRM_ASKER_OPEN_IDS=ou_asker1,ou_asker2,ou_duty
P0_THREAD_CONFIRM_ALLOW_TOPLEVEL_YES=1
P0_THREAD_CONFIRM_TOPLEVEL_GRACE_SEC=180
P0_THREAD_CONFIRM_ALLOW_ASKER_SELF_YES=0
P0_THREAD_CONFIRM_ALLOW_TARGET_MENTIONS=0
P0_THREAD_CONFIRM_USE_GROQ=1

# --- Fanout / hubs ---
OVERVIEW_DETECTION_FANOUT_CHAT_IDS=oc_hub_group_id
P0_MEETING_CREATED_TEXT_CHAT_IDS=oc_hub_group_id
P0_NOTIFICATION_HUB_CHAT_IDS=oc_hub_group_id
INCIDENT_OVERVIEW_SEND_MAP=oc_cp_emergency_group_id=oc_broadcast_group_id,oc_game_urgent_group_id=oc_broadcast_group_id

# --- Overview forwarder ---
LARK_OVERVIEW_FORWARDER_ENABLED=1
LARK_OVERVIEW_FORWARDER_URL=http://127.0.0.1:8011
LARK_OVERVIEW_FORWARDER_SECRET=your_forwarder_shared_secret

# --- VC recording fanout ---
VC_RECORDING_FANOUT_CHAT_IDS=oc_hub_group_id
VC_RECORDING_FANOUT_USER_OPEN_IDS=ou_boss_open_id
VC_RECORDING_FANOUT_SET_PERMISSION=1
VC_RECORDING_FANOUT_TENANT_WIDE_VIEW=1
VC_RECORDING_FANOUT_TOPIC_SUBSTRING=Video meeting
VC_RECORDING_FANOUT_DRIVE_PERM=edit

# --- VC ring / OAuth — OFF (do not enable on prod unless intended) ---
P0_VC_RING_ENABLED=0
P0_VC_OAUTH_PUBLIC_BASE_URL=https://mybot.ink
P0_VC_OAUTH_REDIRECT_URI=https://mybot.ink/lark/oauth/callback
P0_VC_OAUTH_SCOPE=vc:meeting offline_access vc:record docs:permission.member:create docs:permission.member:update
P0_MAJOR_CHECK_PERSON_IDS=
P0_MAJOR_CHECK_PERSON_JOIN_THREAD_TEXT={name} is already in the P0 meeting.
P0_VC_AUTO_CANCEL_IF_NO_JOINS_CHAT_SEC=6000
P0_VC_AUTO_CANCEL_IF_NO_JOINS_CHAT_IDS=oc_cp_emergency_group_id,oc_game_urgent_group_id

# --- Ongoing DM buzz ---
P0_ONGOING_DM_BUZZ_ENABLED=1
P0_ONGOING_DM_BUZZ_MAJOR_DELAY_SEC=300
P0_ONGOING_DM_BUZZ_MINOR_DELAY_SEC=600
P0_ONGOING_CONTACT_NAMES=Greg and Eason

# --- Issue Watch — OFF (do not enable on prod unless intended) ---
P0_ISSUE_WATCH_ENABLED=0
P0_ISSUE_WATCH_AI_PROVIDER=claude
P0_ISSUE_WATCH_MIN_CONFIDENCE=0.75
P0_ISSUE_WATCH_WINDOW_MIN=60
P0_ISSUE_WATCH_MIN_REPORTS=4
P0_ISSUE_WATCH_MIN_AFFECTED_PLAYERS=3
P0_ISSUE_WATCH_COOLDOWN_MIN=20
P0_ISSUE_WATCH_AUTO_OVERVIEW=1
P0_ISSUE_WATCH_BUZZ_ENABLED=1
P0_ISSUE_WATCH_LARK_URGENT_MODE=app
P0_ISSUE_WATCH_DECLARE_P0_ENABLED=1
P0_ISSUE_WATCH_DECLARE_REPLY_AI=1
P0_ISSUE_WATCH_DECLARE_REPLY_TEXT=We will declare this issue as P0.
P0_ISSUE_WATCH_DECLARE_REACTION=OnIt
P0_ISSUE_WATCH_DECLARE_REPLY_IN_THREAD=1
P0_ISSUE_WATCH_DECLARE_ALSO_SEND_TO_GROUP=1
P0_ISSUE_WATCH_DECLARE_CHECK_PERSON_REPLY_TEXT=Calling and inviting the checkpersons for major P0 issues. Thank you.

# --- Bitable 📦 deploy + 🔴 线上操作汇总 (P0 declare + after Send overview) ---
P0_ADJUSTMENT_BITABLE_ENABLED=1
P0_ADJUSTMENT_BITABLE_APP_TOKEN=LVrubE8f8af1yTslQgqlIaWPgcg
P0_ADJUSTMENT_BITABLE_TABLE_ID=tblHHa3NmHmWian6
P0_ADJUSTMENT_BITABLE_OPS_TABLE_ID=tblTNzlhFdyrKgG8
P0_ADJUSTMENT_BITABLE_ON_P0_DECLARE=1
P0_ADJUSTMENT_BITABLE_THREAD_FOLLOWUPS=1
P0_ADJUSTMENT_BITABLE_POST_CHAT_ID=oc_cp_emergency_group_id

# --- Ops monitoring GC (ERROR alerts + duty warning mirrors) ---
P0_MONITORING_CHAT_IDS=oc_monitoring_group_id
P0_MONITORING_DUTY_WARNINGS=1
P0_MONITORING_LOG_ALERTS=1
P0_MONITORING_LOG_MIN_LEVEL=ERROR
P0_MONITORING_ALERT_COOLDOWN_SEC=120

# --- Grafana screenshots ---
P0_GRAPH_SCREENSHOT_ENABLED=1
P0_GRAPH_SCREENSHOT_URL=https://grafana.example.com/d/your-dashboard-uid/slug?orgId=1&from=now-6h&to=now&timezone=browser&refresh=1m
P0_GRAPH_SCREENSHOT_USERNAME=om_duty
P0_GRAPH_SCREENSHOT_PASSWORD=your_grafana_password
P0_GRAPH_SCREENSHOT_TARGET_CHAT_ID=oc_screenshot_group_id
P0_GRAPH_SCREENSHOT_PLAYWRIGHT_USER_DATA_DIR=/var/lib/lark-ops-ai/grafana-playwright-profile
P0_GRAPH_SCREENSHOT_KIOSK=1
P0_GRAPH_SCREENSHOT_VIEWPORT_ONLY=1
P0_GRAPH_SCREENSHOT_TOP_AND_BOTTOM=1
P0_GRAPH_SCREENSHOT_INCLUDE_LOGIN_PANEL=0
P0_GRAPH_SCREENSHOT_SPLIT_VERTICAL_HALVES=0
P0_GRAPH_SCREENSHOT_ZOOM_PERCENT=78
P0_GRAPH_SCREENSHOT_VIEWPORT_WIDTH=1920
P0_GRAPH_SCREENSHOT_VIEWPORT_HEIGHT=1080
P0_GRAPH_SCREENSHOT_DEVICE_SCALE_FACTOR=1
P0_GRAPH_SCREENSHOT_CHROMIUM_ARGS=--no-sandbox,--disable-dev-shm-usage
P0_GRAPH_SCREENSHOT_INCLUDE_TIME_BAR=1
P0_GRAPH_SCREENSHOT_GOTO_WAIT_UNTIL=load
P0_GRAPH_SCREENSHOT_NAV_TIMEOUT_MS=120000
P0_GRAPH_SCREENSHOT_PANEL_READY_TIMEOUT_MS=30000
P0_GRAPH_SCREENSHOT_PANEL_CONTENT_READY_TIMEOUT_MS=90000
P0_GRAPH_SCREENSHOT_BAND_MAX_WAIT_MS=40000
P0_GRAPH_SCREENSHOT_WAIT_MS=10000
P0_GRAPH_SCREENSHOT_FAST_CAPTURE=1
P0_GRAPH_SCREENSHOT_BAND_WARM_SCROLL=1
P0_GRAPH_SCREENSHOT_BAND_MAX_BLANK_PANELS=0
P0_GRAPH_SCREENSHOT_INTERVAL_MIN=30
P0_GRAPH_SCREENSHOT_AUTO_RANGES=6h
P0_GRAPH_SCREENSHOT_ON_DEMAND=1
P0_GRAPH_SCREENSHOT_BROWSER_POOL=1
P0_GRAPH_SCREENSHOT_ON_DEMAND_FAST=1
P0_GRAPH_SCREENSHOT_ON_DEMAND_BAND_MAX_WAIT_MS=28000
P0_GRAPH_SCREENSHOT_ON_DEMAND_BAND_STABLE_POLLS=2
P0_GRAPH_SCREENSHOT_ON_DEMAND_MAX_SEC=360
P0_GRAPH_SCREENSHOT_REACT=1
P0_GRAPH_SCREENSHOT_REACT_QUEUED=OnIt
P0_GRAPH_SCREENSHOT_REACT_DONE=DONE
P0_GRAPH_SCREENSHOT_REACT_FAILED=ERROR
P0_GRAPH_SCREENSHOT_CAPTION=As of: {captured_at} · Last {range}
P0_GRAPH_SCREENSHOT_AI=1
P0_GRAPH_SCREENSHOT_AI_PROVIDER=claude
