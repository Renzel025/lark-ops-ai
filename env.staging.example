# =============================================================================
# STAGING / DEV SERVER — full .env (not an overlay)
# Use on a SEPARATE machine from production (e.g. ose-bot-dev).
#
# Setup:
#   cp env.staging.example .env
#   Fill secrets (can be same Lark app or a dedicated dev app).
#   Set dev-only group IDs below — never point at prod incident groups.
# =============================================================================

ENV_PATH=/root/lark-ops-ai/.env

# --- Lark app (dev app recommended; or same app with webhook URL = staging server only) ---
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=your_app_secret_here
LARK_ENCRYPT_KEY=your_encrypt_key_here

# --- Dev detection + prompt groups only ---
INCIDENT_GROUP_IDS=oc_your_dev_detection_group
INCIDENT_OVERVIEW_TARGET_MAP=oc_dev_detection=oc_dev_prompt
INCIDENT_GROUP_EMERGENCY_TOPICS="oc_dev_detection=p0 detection dev"

# Duty DM while testing (your ou_...)
P0_DM_INSTRUCTION_OPEN_IDS=ou_your_open_id

# Shared state on this server only (not prod path)
P0_SHARED_STATE_DIR=/var/lib/lark-ops-ai-staging

# Issue Watch — safe to exercise on dev
P0_ISSUE_WATCH_ENABLED=1
P0_ISSUE_WATCH_AUTO_OVERVIEW=1
P0_ISSUE_WATCH_BUZZ_ENABLED=1

# Turn off heavy / external side effects on staging until you need them
P0_GRAPH_SCREENSHOT_ENABLED=0
# Staging: no Slack huddle (removed — use Lark VC ring instead)
LARK_OVERVIEW_FORWARDER_ENABLED=0

# API keys (same keys as prod OK for AI testing)
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: label in logs
# STAGING=1
