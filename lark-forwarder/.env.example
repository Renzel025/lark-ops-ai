# lark-forwarder — load via systemd EnvironmentFile (forwarder does not auto-load .env)
LARK_FORWARDER_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/...
# Optional per broadcast group: oc_xxx=https://...,oc_yyy=https://...
# LARK_FORWARDER_WEBHOOK_MAP=
# Must match Primary LARK_OVERVIEW_FORWARDER_SECRET
LARK_FORWARDER_SECRET=change-me
