# Overview bot Lark app (Developer Console → Credentials & Basic Info)
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Broadcast group chat id — Overview bot must already be added to this group
LARK_FORWARDER_BROADCAST_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shared secret with Primary (LARK_OVERVIEW_FORWARDER_SECRET)
LARK_FORWARDER_SECRET=change-me

# Optional — only if your tenant uses a different Open API host
# LARK_OPEN_API_BASE=https://open-sg.larksuite.com/open-apis

# Optional fallback — custom bot webhook (not needed if LARK_APP_ID/SECRET are set)
# LARK_FORWARDER_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/...
