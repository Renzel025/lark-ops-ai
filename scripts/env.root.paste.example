# lark-ops-ai repo root .env — Slack Huddle + (optional) Lark bot
# Use when clone lives at /root/lark-ops-ai and processes run as root.
#   cp scripts/env.root.paste.example /root/lark-ops-ai/.env && nano /root/lark-ops-ai/.env

ENV_PATH=/root/lark-ops-ai/.env

SESSION_DIR=/root/lark-ops-ai/puppeteer/slack_session_new
CHROME_PATH=/usr/bin/google-chrome-stable
SLACK_CHANNEL_URL=https://app.slack.com/client/TXXXXXXXX/CXXXXXXXX

SLACK_SUBPROCESS_PYTHON=/root/lark-ops-ai/.venv/bin/python

# SLACK_PLAYWRIGHT_LOG=/root/lark-ops-ai/logs/slack_huddle_run.log

SLACK_HUDDLE_CLOSE_BLANK_POPUP=1
SLACK_HUDDLE_EVAL_CLICK=1
HARD_TIMEOUT_MS=300000

# SLACK_CHROME_USER_AGENT=...   # optional

# --- Lark bot (main.py) — fill from your existing secrets ---
# LARK_APP_ID=
# LARK_APP_SECRET=
# LARK_ENCRYPT_KEY=
# GROQ_API_KEY=
# ... see README.md, p0_logic/README.md
