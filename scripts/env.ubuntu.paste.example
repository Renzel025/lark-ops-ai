# Copy to lark-ops-ai repo root as .env:
#   cp scripts/env.ubuntu.paste.example .env
# Edit paths (use YOUR user + clone path, e.g. /home/ubuntu/lark-ops-ai) and SLACK_CHANNEL_URL.
#
# This file is for Slack Huddle Playwright (scripts/run_slack_huddle.py).
# Add your Lark bot vars in the SAME .env (LARK_APP_ID, etc.) — one file for both.

# --- Slack Huddle (required) ---
SESSION_DIR=/home/ubuntu/lark-ops-ai/puppeteer/slack_session_new
CHROME_PATH=/usr/bin/google-chrome-stable
SLACK_CHANNEL_URL=https://app.slack.com/client/TXXXXXXXX/CXXXXXXXX

SLACK_SUBPROCESS_PYTHON=/home/ubuntu/lark-ops-ai/.venv/bin/python

# systemd / optional explicit path to this file (usually omit if .env is repo root)
# ENV_PATH=/home/ubuntu/lark-ops-ai/.env

# Optional logs
# SLACK_PLAYWRIGHT_LOG=/home/ubuntu/lark-ops-ai/logs/slack_huddle_run.log

# Huddle tuning (blank pop-out / Start Huddle)
SLACK_HUDDLE_CLOSE_BLANK_POPUP=1
SLACK_HUDDLE_EVAL_CLICK=1
HARD_TIMEOUT_MS=300000

# SLACK_CHROME_USER_AGENT=...   # optional; match Chrome major from chrome://version

# --- Lark bot (main.py / p0_logic) — kung wala pa; kopyahin mula sa existing .env mo ---
# LARK_APP_ID=
# LARK_APP_SECRET=
# LARK_ENCRYPT_KEY=
# GROQ_API_KEY=
# ... (tingnan README.md at p0_logic/README.md)
