# Overview / lark-forwarder — separate subdomain from primary bot.
#   sudo cp scripts/nginx/lark-forwarder-staging.conf.example /etc/nginx/conf.d/lark-forwarder.conf
#   sudo nginx -t && sudo systemctl reload nginx
#
# Primary bot: testdev.mybot.ink → :8000 (/lark/webhook)
# Overview:   testoverview.mybot.ink → :8011 (/webhook)

server {
    listen 80;
    listen [::]:80;
    server_name testoverview.mybot.ink;

    location / {
        proxy_pass http://127.0.0.1:8011;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
