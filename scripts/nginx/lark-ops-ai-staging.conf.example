# Staging / dev — copy to nginx and replace DOMAIN.
#   sudo cp scripts/nginx/lark-ops-ai-staging.conf.example /etc/nginx/sites-available/lark-ops-ai-staging
#   sudo sed -i 's/DOMAIN/testdev.mybot.ink/g' /etc/nginx/sites-available/lark-ops-ai-staging
#   sudo ln -sf /etc/nginx/sites-available/lark-ops-ai-staging /etc/nginx/sites-enabled/
#
# Before certbot: use only the :80 block (or certbot --nginx will add SSL).
# After certbot: full HTTPS block below.

server {
    listen 80;
    listen [::]:80;
    server_name DOMAIN;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}

# After: sudo certbot --nginx -d DOMAIN
# Certbot adds the :443 server block automatically, or merge manually:

